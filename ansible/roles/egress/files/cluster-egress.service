# Managed by Ansible (ansible/roles/egress), SOP-104.
# Loads the network limits for customer accounts before the network comes up.
[Unit]
Description=Network limits for customer accounts (SOP-104)
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables/cluster-egress.nft
ExecReload=/usr/sbin/nft -f /etc/nftables/cluster-egress.nft
ExecStop=/usr/sbin/nft delete table inet cluster_egress

[Install]
WantedBy=multi-user.target
