# Managed by Ansible (ansible/roles/slurm_controller), SOP-152. Holds the database password: slurm only.
AuthType=auth/munge
DbdHost={{ inventory_hostname }}
SlurmUser=slurm
DebugLevel=info
LogFile=/var/log/slurm/slurmdbd.log
PidFile=/run/slurmdbd/slurmdbd.pid
StorageType=accounting_storage/mysql
StorageHost=localhost
StorageUser=slurm
StoragePass={{ slurmdb_password.content | b64decode | trim }}
StorageLoc=slurm_acct_db
# Customers see only their own data through sacct, sacctmgr and sreport too (review W9).
PrivateData=accounts,jobs,reservations,usage,users
# Job scripts are kept 60 days (design Q5); job records themselves are kept forever.
PurgeJobScriptAfter=60days
