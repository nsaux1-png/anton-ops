# Managed by Ansible (ansible/roles/slurm_node), SOP-155.
# pam_slurm_adopt runs inside sshd (sshd_t). To find a user's jobs on this node it opens the job steps'
# sockets in slurmd's spool folder (var_spool_t), and asks slurmstepd (unconfined_service_t) to put the
# login into the job. Without this, every login with a job was refused ("no active jobs"). Adapted from
# the example in Slurm's pam_slurm_adopt documentation, with the denials read from douglas1's audit log
# (2026-10-21). 1.1: joining the job's namespace, for its private /tmp.
module cluster_pam_slurm_adopt 1.1;

require {
	type sshd_t;
	type var_spool_t;
	type unconfined_service_t;
	type nsfs_t;
	class dir { getattr open read search };
	class sock_file { getattr write };
	class unix_stream_socket connectto;
	class file read;
	class fd use;
	class capability sys_admin;
}

allow sshd_t var_spool_t:dir { getattr open read search };
allow sshd_t var_spool_t:sock_file { getattr write };
allow sshd_t unconfined_service_t:unix_stream_socket connectto;

# Joining the job's private /tmp (namespace/tmpfs, SOP-132): open its namespace file, use the descriptor
# slurmstepd passes over, and setns into it (Slurm's documented example for namespace/tmpfs).
allow sshd_t nsfs_t:file read;
allow sshd_t unconfined_service_t:fd use;
allow sshd_t self:capability sys_admin;
